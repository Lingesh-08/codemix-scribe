# Copy this file to supabase.env (git-ignored) and fill in your Supabase values.
# Supabase dashboard -> your project -> Connect -> "Session pooler" (works on IPv4 networks).
#   host:  aws-0-<region>.pooler.supabase.com     port: 5432     database: postgres
#   user:  postgres.<your-project-ref>
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_POOL_SIZE=5
