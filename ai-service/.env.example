# Copy to .env and edit.
# Kaggle tunnel URL (changes every session; you can also paste it in the app's Settings page)
GEMMA_URL=
# Optional: must match GEMMA_TOKEN in the Kaggle notebook if you set one there
GEMMA_TOKEN=
BACKEND_URL=http://localhost:8080
# Must match the backend's SERVICE_SECRET and JWT_SECRET (these are the dev defaults)
SERVICE_SECRET=scribe-dev-service-secret
JWT_SECRET=scribe-dev-jwt-secret-change-me-0123456789abcdef

# ASR language. Empty ASR_LANGUAGE = detect per recording, choosing only from ASR_LANGUAGES
# (Tamil -> Tamil script, Hindi -> Devanagari). Set ASR_LANGUAGE=ta to always force Tamil.
ASR_LANGUAGE=
ASR_LANGUAGES=ta,hi
# Optional: override the code-mixed sample prompts (ASR_PROMPT_TA / ASR_PROMPT_HI).
WHISPER_COMPUTE_TYPE=int8_float16

# Clinical coding (SNOMED CT / LOINC / ICD-10)
# Free Gemini key from https://aistudio.google.com/apikey  (the transcript is sent to Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
FHIR_TERMINOLOGY_URL=https://r4.ontoserver.csiro.au/fhir
# Full path to YOUR local SNOMED CT -> ICD-10 map (RF2 ExtendedMap .txt or CSV). Stays on this laptop.
ICD10_MAP_PATH=
# Used when the main model is overloaded or slow
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.8-flash

# Local folders (only used by scripts/test_asr.py)
TEST_AUDIO_DIR=
